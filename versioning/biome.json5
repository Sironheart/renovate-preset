{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["customManagers:biomeVersions"],
  packageRules: [
    {
      description: "Group Biome updates across package.json, mise.toml, and schema JSON.",
      groupName: "Biome",
      groupSlug: "biome",
      matchPackageNames: ["@biomejs/biome", "npm:@biomejs/biome"],
    },
  ],
}
