{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Automerge trusted tooling updates after CI passes.",
  packageRules: [
    {
      description: "Create Renovate and formatter updates every second night, then automerge after CI passes.",
      matchPackageNames: [
        "@biomejs/biome",
        "docker.io/renovate/renovate",
        "ghcr.io/renovatebot/renovate",
        "oxfmt",
        "prettier",
        "renovate",
        "renovate/renovate",
        "renovatebot/renovate",
      ],
      schedule: ["* 0-5 */2 * *"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      description: "Automerge non-major mise CLI, GitHub Actions, and image updates across managers.",
      matchPackageNames: ["mise", "jdx/mise", "jdx/mise-action", "ghcr.io/jdx/mise"],
      matchUpdateTypes: ["minor", "patch", "pin", "pinDigest", "digest"],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
  ],
}
