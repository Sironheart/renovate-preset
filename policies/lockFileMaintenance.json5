{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Refresh lock files and automerge maintenance after CI passes.",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-3 * * 1"],
    automerge: true,
    automergeType: "pr",
    platformAutomerge: true,
  },
}
