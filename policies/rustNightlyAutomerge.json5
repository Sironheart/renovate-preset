{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Group Rust nightly toolchains and images twice monthly, then platform-automerge after required CI passes. Merging may happen outside the creation schedule.",
  packageRules: [
    {
      description: "Group nightly updates across mise, asdf, Rust toolchain files, and Rust Docker images on the 1st and 15th.",
      matchDatasources: ["rust-version", "docker"],
      matchPackageNames: [
        "rust",
        "library/rust",
        "docker.io/rust",
        "docker.io/library/rust",
        "rustlang/rust",
        "docker.io/rustlang/rust",
      ],
      matchCurrentValue: "/^nightly(?:-|$)/",
      groupName: "Rust nightly",
      groupSlug: "rust-nightly",
      separateMajorMinor: false,
      separateMinorPatch: false,
      schedule: ["* * 1,15 * *"],
      updateNotScheduled: false,
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      description: "Pin floating nightly toolchain channels to dated releases so Renovate can advance them.",
      matchDatasources: ["rust-version"],
      matchPackageNames: ["rust"],
      matchCurrentValue: "/^nightly(?:-|$)/",
      rangeStrategy: "pin",
    },
    {
      description: "Compare dated nightly image tags chronologically while preserving image variants.",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "rust",
        "library/rust",
        "docker.io/rust",
        "docker.io/library/rust",
        "rustlang/rust",
        "docker.io/rustlang/rust",
      ],
      matchCurrentValue: "/^nightly-\\d{4}-\\d{2}-\\d{2}(?:-|$)/",
      versioning: "regex:^nightly-(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})(?:-(?<compatibility>.+))?$",
    },
  ],
}
