{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  semanticCommits: "enabled",
  packageRules: [
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}{{#if semanticCommitScope}}({{semanticCommitScope}}){{/if}}!:",
      commitMessageExtra: "({{currentVersion}} ➔ {{newVersion}})",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "({{currentVersion}} ➔ {{newVersion}})",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "({{currentVersion}} ➔ {{newVersion}})",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "fix",
      commitMessageExtra: "({{currentDigestShort}} ➔ {{newDigestShort}})",
    },
    {
      matchDepTypes: ["devDependencies"],
      semanticCommitType: "chore",
      // Dev dependencies are not part of the deliverable, so majors are not breaking.
      commitMessagePrefix: "{{semanticCommitType}}{{#if semanticCommitScope}}({{semanticCommitScope}}){{/if}}:",
    },
    {
      description: "Shorten long dependency names, e.g. go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc becomes go.opentelemetry.io/.../otlptracegrpc. Typed topics below take precedence.",
      matchJsonata: ["$length(depName) > 50"],
      commitMessageTopic: "dependency {{replace '^([^/]+)/.+/([^/]+)$' '$1/.../$2' depName}}",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchDatasources: ["helm"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitType: "chore",
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["renovate-config"],
      semanticCommitType: "chore",
      semanticCommitScope: "renovate-config",
      commitMessageTopic: "config {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitType: "chore",
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
      // mise tools are local dev tooling, not part of the deliverable, so majors are not breaking.
      commitMessagePrefix: "{{semanticCommitType}}{{#if semanticCommitScope}}({{semanticCommitScope}}){{/if}}:",
    },
  ],
}
