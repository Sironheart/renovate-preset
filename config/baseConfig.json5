{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Stock Renovate presets and shared rules that form the base of this bundle. Listed alphabetically first so subsequent presets in this repo can override.",
  extends: [
    "config:best-practices",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    ":disableRateLimiting",
    "customManagers:githubActionsVersions",
    "customManagers:helmChartYamlAppVersions",
    "customManagers:makefileVersions",
    "customManagers:tsconfigNodeVersions",
  ],
  packageRules: [
    {
      description: "Group updates for the same upstream source across managers.",
      matchSourceUrls: ["*"],
      groupName: "{{{sourceUrl}}}",
    },
  ],
}
